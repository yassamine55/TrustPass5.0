# --- Serveur ---
MONGO_URI=mongodb://127.0.0.1:27017/reloop
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=reloop-passport-api
PORT=5000
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads

# --- Compte administrateur unique (npm run seed:admin) ---
ADMIN_EMAIL=admin@reloop.local
ADMIN_PASSWORD=replace_with_a_secure_admin_password

# --- Hedera ---
HEDERA_NETWORK=testnet
HEDERA_ENABLED=false
# Compte testnet gratuit : https://portal.hedera.com
HEDERA_OPERATOR_ID=0.0.<your-account-id>
HEDERA_OPERATOR_KEY=replace_with_your_hedera_private_key
# Créés depuis l'interface (Admin > Configuration Hedera), puis collés ici
HEDERA_TOPIC_ID=
HEDERA_DEVICE_TOKEN_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
# Facultatif pour un fournisseur Mirror Node hébergé
HEDERA_MIRROR_NODE_API_KEY=
HEDERA_TRANSACTION_TIMEOUT_MS=60000
HEDERA_MIRROR_NODE_TIMEOUT_MS=10000
