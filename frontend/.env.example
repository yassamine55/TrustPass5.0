# URL du backend pour le proxy de développement (npm run dev / preview)
VITE_PROXY_TARGET=http://localhost:5000
# Local phone testing: VITE_PUBLIC_APP_URL=http://192.168.0.172:5173
VITE_PUBLIC_APP_URL=http://192.168.0.172:5173
# Deployed example: VITE_PUBLIC_APP_URL=https://app.example.com
# Réseau Hedera utilisé pour les liens HashScan (testnet | mainnet | previewnet)
VITE_HEDERA_NETWORK=testnet
# En production, si l'API est sur un autre domaine : VITE_API_URL=https://api.exemple.com/api
